{
  "realm": "prodavan",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "accessTokenLifespan": 3600,
  "ssoSessionIdleTimeout": 315360000,
  "ssoSessionMaxLifespan": 315360000,
  "clientSessionIdleTimeout": 0,
  "clientSessionMaxLifespan": 0,
  "offlineSessionIdleTimeout": 315360000,
  "offlineSessionMaxLifespan": 315360000,
  "offlineSessionMaxLifespanEnabled": true,
  "roles": {
    "realm": [
      {
        "name": "platform.admin",
        "description": "Platform Admin control plane",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "company",
        "description": "Company org principal (independent entity login)",
        "composite": false,
        "clientRole": false
      },
      {
        "name": "employee",
        "description": "Employee human principal",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "clients": [
    {
      "clientId": "prodavan-flutter",
      "name": "Prodavan Flutter",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://127.0.0.1:*",
        "http://localhost:*",
        "prodavan://*"
      ],
      "webOrigins": ["+"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "client.offline.session.idle.timeout": "315360000",
        "client.offline.session.max.lifespan": "315360000"
      },
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email",
        "prodavan-audience"
      ],
      "optionalClientScopes": ["address", "phone", "offline_access"]
    },
    {
      "clientId": "prodavan-api",
      "name": "Prodavan API audience",
      "enabled": true,
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": false,
      "defaultClientScopes": ["roles", "profile", "email"]
    },
    {
      "clientId": "prodavan-services",
      "name": "Prodavan services (invite / workers)",
      "enabled": true,
      "publicClient": false,
      "secret": "change-me-prodavan-services",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "fullScopeAllowed": true,
      "defaultClientScopes": ["roles", "profile", "email", "prodavan-audience"]
    }
  ],
  "identityProviders": [],
  "clientScopes": [
    {
      "name": "prodavan-audience",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "aud-prodavan-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "prodavan-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';"
  }
}
