{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyLegacyAgentscaleBucket",
      "Effect": "Deny",
      "Action": ["s3:*"],
      "Resource": [
        "arn:aws:s3:::agentscale",
        "arn:aws:s3:::agentscale/*"
      ]
    },
    {
      "Sid": "AllowListTenantBuckets",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": ["arn:aws:s3:::tenant-*"]
    },
    {
      "Sid": "AllowReadTenantModulePrefixes",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": ["arn:aws:s3:::tenant-*/module-*"]
    },
    {
      "Sid": "AllowWriteTenantModulePrefixes",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:DeleteObject"],
      "Resource": ["arn:aws:s3:::tenant-*/module-*"]
    },
    {
      "Sid": "AllowLifecycleTenantBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucket",
        "s3:GetBucketPolicy",
        "s3:PutBucketPolicy"
      ],
      "Resource": ["arn:aws:s3:::tenant-*"]
    }
  ]
}
