# Example — copy to .env (gitignored). Prefer RUNNER_TOKEN from:
#   gh api -X POST repos/ne-tort/prodavan/actions/runners/registration-token --jq .token
REPO_URL=https://github.com/ne-tort/prodavan
RUNNER_NAME=wsl-prodavan
RUNNER_TOKEN=
# Or PAT with repo admin (manage runners):
# ACCESS_TOKEN=
LABELS=self-hosted,linux,docker,wsl-dev
# Prevent mid-job self-update (kills jobs with "Runner update in progress")
DISABLE_RUNNER_UPDATE=1
DISABLE_AUTO_UPDATE=true
RUNNER_SCOPE=repo
