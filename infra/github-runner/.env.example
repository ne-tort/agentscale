# GitHub Actions runner pack (Docker Desktop)
REPO_URL=https://github.com/ne-tort/prodavan
# Prefer PAT (repo scope) so all 4 named services can register:
#   gh auth token
ACCESS_TOKEN=
# Or one registration token (only enough for a single configure without PAT):
#   gh api -X POST repos/ne-tort/prodavan/actions/runners/registration-token --jq .token
RUNNER_TOKEN=
RUNNER_NAME_PREFIX=dd-pv
LABELS=self-hosted,linux,docker,docker-desktop
# Leave EMPTY for persistent runners. myoung34 treats ANY non-empty value as --ephemeral
# (so EPHEMERAL=false would wrongly enable one-job runners). Set to 1 only if intentional.
EPHEMERAL=
# Four fixed services runner-1..4 in docker-compose.yml (not --scale).
# Windows path mounted read-only as /home/runner/.kube (Verify Dev)
# PROD_VAN_KUBE_DIR=C:\Users\YOU\.kube
