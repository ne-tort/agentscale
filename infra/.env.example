# Copy to infra/.env for local overrides (optional)

POSTGRES_USER=prodavan
POSTGRES_PASSWORD=prodavan
POSTGRES_DB=prodavan

MINIO_ROOT_USER=prodavan
MINIO_ROOT_PASSWORD=prodavan123

# API (apps/api/.env) — app connects as prodavan_app (RLS enforced)
DATABASE_URL=postgresql+asyncpg://prodavan_app:prodavan@localhost:5432/prodavan
# Migrations only (superuser):
# DATABASE_URL=postgresql+asyncpg://prodavan:prodavan@localhost:5432/prodavan alembic upgrade head
JWT_SECRET=dev-change-me-in-production
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
DEV_KMS_KEY=dev-key-base64
