{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prodavan.dev/schemas/plugin-manifest/v1/protocol.json",
  "title": "Agentscale plugin-rpc/1 Message Contract",
  "description": "Единый двунаправленный контракт iframe ↔ shell. Дискриминатор — только type; transport origin проверяется отдельно через MessageEvent.origin и точный WindowProxy и никогда не принимается из payload.",
  "$comment": "Opaque origin \"null\" допустим только как transport condition sandboxed iframe: обязательны точный WindowProxy, обязательные nonce/instance_id и digest из реестра. Wildcard targetOrigin при отправке в opaque frame не является доверием. Данные сообщения не содержат origin, capability token или URL broker/proxy.",
  "oneOf": [
    { "$ref": "#/$defs/hostReady" },
    { "$ref": "#/$defs/pluginReady" },
    { "$ref": "#/$defs/grantReady" },
    { "$ref": "#/$defs/pluginRpcRequest" },
    { "$ref": "#/$defs/pluginRpcResponse" },
    { "$ref": "#/$defs/pluginError" }
  ],
  "$defs": {
    "protocol": { "const": "plugin-rpc/1" },
    "pluginId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 128 },
    "semver": { "type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$", "maxLength": 64 },
    "artifactDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instanceToken": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "scopeId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "jsonValue": {},
    "requestContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "company_id": { "$ref": "#/$defs/scopeId" },
        "cabinet_id": { "$ref": "#/$defs/scopeId" },
        "project_id": { "$ref": "#/$defs/scopeId" },
        "session_id": { "$ref": "#/$defs/scopeId" }
      }
    },
    "capabilityRef": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
        "version": { "type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z._+-]{0,63}$" }
      }
    },
    "grantCapabilities": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}(?:@[0-9A-Za-z][0-9A-Za-z._+-]{0,63})?$" }
    },
    "hostNavigateInput": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/(?!/)[A-Za-z0-9._/-]{0,511}$",
          "not": { "pattern": "(?:^|/)\\.\\.(?:/|$)" }
        }
      }
    },
    "hostResizeInput": {
      "type": "object",
      "required": ["height"],
      "additionalProperties": false,
      "properties": {
        "height": { "type": "number", "minimum": 0, "maximum": 10000 }
      }
    },
    "rpcError": {
      "type": "object",
      "required": ["code", "message", "trace_id"],
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "ORIGIN_MISMATCH",
            "PROTOCOL_UNSUPPORTED",
            "HANDSHAKE_MISMATCH",
            "HANDSHAKE_TIMEOUT",
            "NONCE_MISMATCH",
            "UNKNOWN_METHOD",
            "CAPABILITY_DENIED",
            "DUPLICATE_REQUEST_ID",
            "PAYLOAD_TOO_LARGE",
            "SCOPE_DENIED",
            "GRANT_EXPIRED",
            "INVALID_ENVELOPE",
            "REQUEST_FAILED",
            "REQUEST_TIMEOUT"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "trace_id": { "$ref": "#/$defs/requestId" }
      }
    },
    "hostReady": {
      "type": "object",
      "$comment": "host -> plugin, только после первого iframe load.",
      "required": ["protocol", "type", "plugin_id", "version", "artifact_digest", "instance_id", "nonce"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "host.ready" },
        "plugin_id": { "$ref": "#/$defs/pluginId" },
        "version": { "$ref": "#/$defs/semver" },
        "artifact_digest": { "$ref": "#/$defs/artifactDigest" },
        "instance_id": { "$ref": "#/$defs/instanceToken" },
        "nonce": { "$ref": "#/$defs/instanceToken" }
      }
    },
    "pluginReady": {
      "type": "object",
      "$comment": "plugin -> host: обязательное эхо identity/digest/instance/nonce из host.ready.",
      "required": ["protocol", "type", "plugin_id", "version", "artifact_digest", "instance_id", "nonce"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "plugin.ready" },
        "plugin_id": { "$ref": "#/$defs/pluginId" },
        "version": { "$ref": "#/$defs/semver" },
        "artifact_digest": { "$ref": "#/$defs/artifactDigest" },
        "instance_id": { "$ref": "#/$defs/instanceToken" },
        "nonce": { "$ref": "#/$defs/instanceToken" }
      }
    },
    "grantReady": {
      "type": "object",
      "$comment": "host -> plugin после валидного plugin.ready. capabilities/scope/expires_at — effective grant этого канала, не capability token.",
      "required": ["protocol", "type", "plugin_id", "version", "artifact_digest", "instance_id", "nonce", "capabilities", "scope", "expires_at"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "grant.ready" },
        "plugin_id": { "$ref": "#/$defs/pluginId" },
        "version": { "$ref": "#/$defs/semver" },
        "artifact_digest": { "$ref": "#/$defs/artifactDigest" },
        "instance_id": { "$ref": "#/$defs/instanceToken" },
        "nonce": { "$ref": "#/$defs/instanceToken" },
        "capabilities": { "$ref": "#/$defs/grantCapabilities" },
        "scope": { "$ref": "#/$defs/requestContext" },
        "expires_at": { "type": "string", "format": "date-time" }
      }
    },
    "pluginRpcRequest": {
      "type": "object",
      "$comment": "Двунаправленный typed request. capability.call требует versioned capability и idempotency_key; host.navigate принимает только внутренний path, generic proxy/fetch URL отсутствует.",
      "required": ["protocol", "type", "plugin_id", "version", "artifact_digest", "instance_id", "nonce", "request_id", "method", "context", "input"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "plugin.rpc.request" },
        "plugin_id": { "$ref": "#/$defs/pluginId" },
        "version": { "$ref": "#/$defs/semver" },
        "artifact_digest": { "$ref": "#/$defs/artifactDigest" },
        "instance_id": { "$ref": "#/$defs/instanceToken" },
        "nonce": { "$ref": "#/$defs/instanceToken" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "method": { "enum": ["capability.call", "host.navigate", "host.resize"] },
        "capability": { "$ref": "#/$defs/capabilityRef" },
        "context": { "$ref": "#/$defs/requestContext" },
        "idempotency_key": { "$ref": "#/$defs/requestId" },
        "input": { "$ref": "#/$defs/jsonValue" }
      },
      "allOf": [
        {
          "if": { "properties": { "method": { "const": "capability.call" } }, "required": ["method"] },
          "then": { "required": ["capability", "idempotency_key"] }
        },
        {
          "if": { "properties": { "method": { "const": "host.navigate" } }, "required": ["method"] },
          "then": {
            "properties": { "input": { "$ref": "#/$defs/hostNavigateInput" } },
            "not": { "required": ["capability"] }
          }
        },
        {
          "if": { "properties": { "method": { "const": "host.resize" } }, "required": ["method"] },
          "then": {
            "properties": { "input": { "$ref": "#/$defs/hostResizeInput" } },
            "not": { "required": ["capability"] }
          }
        }
      ]
    },
    "pluginRpcResponse": {
      "type": "object",
      "required": ["protocol", "type", "plugin_id", "version", "artifact_digest", "instance_id", "nonce", "request_id", "ok"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "plugin.rpc.response" },
        "plugin_id": { "$ref": "#/$defs/pluginId" },
        "version": { "$ref": "#/$defs/semver" },
        "artifact_digest": { "$ref": "#/$defs/artifactDigest" },
        "instance_id": { "$ref": "#/$defs/instanceToken" },
        "nonce": { "$ref": "#/$defs/instanceToken" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "ok": { "type": "boolean" },
        "result": { "$ref": "#/$defs/jsonValue" },
        "error": { "$ref": "#/$defs/rpcError" }
      },
      "if": { "properties": { "ok": { "const": false } }, "required": ["ok"] },
      "then": { "required": ["error"], "not": { "required": ["result"] } },
      "else": { "required": ["result"], "not": { "required": ["error"] } }
    },
    "pluginError": {
      "type": "object",
      "$comment": "Fatal protocol error. Текст фиксированный/redacted, без stack, секретов и внутренних URL.",
      "required": ["protocol", "type", "plugin_id", "version", "artifact_digest", "instance_id", "nonce", "error"],
      "additionalProperties": false,
      "properties": {
        "protocol": { "$ref": "#/$defs/protocol" },
        "type": { "const": "plugin.error" },
        "plugin_id": { "$ref": "#/$defs/pluginId" },
        "version": { "$ref": "#/$defs/semver" },
        "artifact_digest": { "$ref": "#/$defs/artifactDigest" },
        "instance_id": { "$ref": "#/$defs/instanceToken" },
        "nonce": { "$ref": "#/$defs/instanceToken" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "error": { "$ref": "#/$defs/rpcError" }
      }
    }
  }
}
