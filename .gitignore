# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Local runner assets / runtime
infra/github-runner/*.tar.gz
infra/github-runner/actions-runner*
data/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
dist/
*.egg-info/

# Web (TypeScript / Vite). `dist/` is already ignored above for Python builds.
node_modules/
.vite/
playwright-report/
test-results/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
*.swp

# Terraform
.terraform/
*.tfstate
*.tfstate.*
tools/.terraform-bin/
tools/terraform
tools/terraform.exe

# Local k3s kubeconfig (host only — never commit)
infra/.kube/*
!infra/.kube/.gitkeep
!infra/.kube/README.md

# Local BuildKit layer cache (docker compose / buildx)
.docker-cache/

*.sqlite
*.db
.openclaw-data/

# Local agent tooling (never commit)
.kilo/
.opencode/
.zcode/

# Scratch files: probes, tsc dumps, junit captures written during a run
apps/*/_*.txt
apps/*/_probe_*.py

# Local run logs. Sanitized, cited evidence lives in reports/module-audit/ and is
# committed explicitly; personal pytest/vitest captures never belong in git.
apps/api/*.log
apps/web/_*.log

# Raw local verification captures (sanitized evidence lives in reports/module-audit/).
.scratch-evidence/
apps/api/artifacts/

# Local verification tool binaries downloaded during audit (never commit)
.scratch-evidence/tools/
