DATABASE_URL=postgresql+asyncpg://prodavan_app:prodavan@localhost:5432/prodavan
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5173,http://127.0.0.1:8080,http://prodavan.local

# P0 Redis (C-CACHE). Empty = disabled until Redis is in the env. Prod: set URL + REDIS_REQUIRED=true.
# REDIS_URL=redis://localhost:6379/0
# REDIS_REQUIRED=false

# P0 object storage (C-OBJECT-STORE). local = keys under STORAGE_ROOT; s3 = MinIO/AWS.
# OBJECT_STORE_BACKEND=local
# OBJECT_STORE_MIRROR_LOCAL=true
# OBJECT_STORE_REQUIRED=false
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=prodavan
# S3_REGION=us-east-1
# STORAGE_ROOT=./data/storage

APP_NAME=prodavan-api
APP_VERSION=0.1.0-l06
BUILD_ID=dev
# APP_ENV=dev | prod — prod forbids AUTH_MODE=test
APP_ENV=dev

# L01: test (CI/local HS256) | oidc (JWKS)
AUTH_MODE=test
AUTH_TEST_SECRET=dev-only-test-secret-change-me
OIDC_AUDIENCE=prodavan-api
# KEYCLOAK_ISSUER_URL=http://localhost:8089/realms/prodavan
# OIDC_JWKS_URL=
# KEYCLOAK_INVITE_MODE=fake | admin
# KEYCLOAK_URL=http://localhost:8089
# KEYCLOAK_REALM=prodavan
# KEYCLOAK_ADMIN_CLIENT_ID=prodavan-services
# KEYCLOAK_ADMIN_CLIENT_SECRET=

# VAULT_ADDR=
# VAULT_TOKEN=
# VAULT_KV_MOUNT=secret
# VAULT_KV_PATH_PREFIX=prodavan/ai_keys
# SECRETS_DIR=./data/secrets
# MCP_SANDBOX_SPAWN=false
# MCP_PLATFORM_EVENT_INVOKE=false

# L07/L08/L09 opt-in background workers (share one asyncio loop + pg advisory lock)
# TRIGGER_WORKER_ENABLED=false
# TRIGGER_WORKER_INTERVAL_SEC=5
# TRIGGER_WORKER_MAX_PROJECTS=20
# TRIGGER_WORKER_BATCH_MAX=10
# TRIGGER_OUTBOX_LEASE_SEC=120
# TRIGGER_OUTBOX_MAX_ATTEMPTS=5
# TRIGGER_OUTBOX_BACKOFF_SEC=5
# IDLE_PAUSE_WORKER_ENABLED=false
# Prefer external cron → POST /api/v1/admin/triggers/idle-pause/sweep when worker is off.

# P0 Celery (C-JOBS). When CELERY_ENABLED=true + broker, in-process asyncio loop is skipped.
# Run worker: celery -A prodavan.core.infra.worker_manager.celery_app worker -l info -B
# CELERY_ENABLED=false
# CELERY_BROKER_URL=   # default REDIS_URL
# CELERY_RESULT_BACKEND=
# CELERY_TASK_ALWAYS_EAGER=false

# P0 Kafka (C-EVENT-BUS). Dual-write publish; PG remains SoT until consumer cutover.
# KAFKA_ENABLED=false
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_CLIENT_ID=prodavan-api
# KAFKA_TOPIC_PLATFORM_EVENTS=prodavan.platform.events
# KAFKA_TOPIC_PROJECT_TRIGGERS=prodavan.project.triggers
# KAFKA_REQUIRED=false
# KAFKA_CONSUMER_ENABLED=false
# KAFKA_CONSUMER_GROUP=prodavan-api-triggers
# KAFKA_DRAIN_DEBOUNCE_SEC=1
# KAFKA_CONSUMER_MODE=kick  # kick | dispatch (per-id Celery task)
